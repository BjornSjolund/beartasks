{
  "name": "beartasks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Beartasks — a minimal menu bar / system tray task manager built with Tauri 2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
